{
  "name": "hmd-private-analytics",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "SITE_ORIGIN": "https://hanmd1990.github.io",
    "ACCESS_ISSUER": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAIL": "REPLACE_WITH_OWNER_EMAIL"
  },
  "d1_databases": [{"binding":"DB","database_name":"hmd-analytics","database_id":"REPLACE_AFTER_CREATION","migrations_dir":"migrations"}]
}
